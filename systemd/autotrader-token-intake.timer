[Unit]
Description=AutoTrader Token Intake window (08:15 IST = 02:45 UTC, before the open)
Requires=autotrader-token-intake.service

[Timer]
# Opens the intake port each trading morning at 08:15 IST (~1h before the open) and
# the service stays up until ~10:15 IST (1h after the 09:15 open) via RuntimeMaxSec,
# so a missed pre-open submit is still recoverable. Self-closes on token save.
OnCalendar=Mon..Fri 02:45:00 UTC
Persistent=false

[Install]
WantedBy=timers.target
